3) Thêm số người đã ghi danh (đếm unique users, chỉ enrol đang hoạt động)
mysql -h localhost -u moodle -p'Namduyqa2009@' -D moodlelive -e "
SELECT c.id,
       c.shortname,
       c.fullname,
       COUNT(DISTINCT ue.userid) AS enrolled_users
FROM mdl_course c
LEFT JOIN mdl_enrol e ON e.courseid=c.id AND e.status=0
LEFT JOIN mdl_user_enrolments ue ON ue.enrolid=e.id AND ue.status=0
WHERE c.id<>1
GROUP BY c.id, c.shortname, c.fullname
ORDER BY enrolled_users DESC;"
