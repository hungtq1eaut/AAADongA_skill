
&&&kiểm tra số user online trong 5 phút gần nhất: chuẩn 300 -5p   &&& cuối dòng có dòng tổng

mysql -h localhost -u moodle -p'Namduyqa2009@' -D moodlelive -e "
SELECT id, username, firstname, lastname, last_access
FROM (
  SELECT u.id, u.username, u.firstname, u.lastname,
         FROM_UNIXTIME(MAX(ula.timeaccess)) AS last_access
  FROM mdl_user u
  JOIN mdl_user_lastaccess ula ON u.id = ula.userid
  WHERE ula.timeaccess > (UNIX_TIMESTAMP() - 10)
  GROUP BY u.id, u.username, u.firstname, u.lastname
) AS online
UNION ALL
SELECT NULL, CONCAT('TOTAL: ', COUNT(*), ' users'), NULL, NULL, NULL
FROM (
  SELECT u.id
  FROM mdl_user u
  JOIN mdl_user_lastaccess ula ON u.id = ula.userid
  WHERE ula.timeaccess > (UNIX_TIMESTAMP() - 30)
  GROUP BY u.id
) AS c
ORDER BY last_access DESC;
"



