1) Chuyển Apache sang PHP-FPM + mpm_event

=========================================================================================================================

# Cài FPM + extensions cần cho Moodle
apt -y install php8.1-fpm php8.1-cli php8.1-mysql php8.1-xml php8.1-curl \
               php8.1-zip php8.1-gd php8.1-intl php8.1-mbstring php8.1-soap \
               php8.1-ldap php8.1-redis php8.1-opcache
systemctl enable --now php8.1-fpm

# TẮT các MPM xung đột & mod_php/itk
a2dismod php8.1 mpm_prefork mpm_worker mpm_itk 2>/dev/null || true
rm -f /etc/apache2/mods-enabled/mpm_{prefork,worker,itk}.*
# (Nếu vhost có AssignUserID/RUidGid/SuexecUserGroup → comment đi)
sed -i -E 's/^\s*(AssignUserID|RUidGid|SuexecUserGroup)/# &/g' \
  /etc/apache2/fastpanel2-sites/elnda_eaut_e_usr/elnda.eaut.edu.vn.conf

# BẬT mpm_event + proxy_fcgi
a2enmod mpm_event proxy proxy_fcgi setenvif http2 headers deflate brotli expires

# Handler .php → FPM
cat >/etc/apache2/conf-available/php8.1-fpm.conf <<'EOF'
<FilesMatch "\.php$">
  SetHandler "proxy:unix:/run/php/php8.1-fpm.sock|fcgi://localhost/"
</FilesMatch>
EOF
a2enconf php8.1-fpm

# Comment mọi php_admin_value/php_value trong vhost
sed -i -E 's/^\s*(php_admin_value|php_value)/# &/g' \
  /etc/apache2/fastpanel2-sites/elnda_eaut_e_usr/elnda.eaut.edu.vn.conf

# Apache chạy 8080/8443 (để Nginx giữ 80/443)
sed -i 's/^Listen 80$/Listen 8080/; s/^Listen 443$/Listen 8443/' /etc/apache2/ports.conf
find /etc/apache2 -type f -name '*.conf' -print0 | xargs -0 sed -i \
  -e 's/:80>/:8080>/g' -e 's/:443>/:8443>/g'

