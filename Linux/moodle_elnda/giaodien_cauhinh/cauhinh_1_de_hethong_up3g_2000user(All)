  StartServers 6
  ServerLimit 512
  ThreadsPerChild 32
  MaxRequestWorkers 512
  MaxConnectionsPerChild 8000
  KeepAlive On
  MaxKeepAliveRequests 100
  KeepAliveTimeout 2
</IfModule>
EOF

apachectl -t && systemctl restart apache2

